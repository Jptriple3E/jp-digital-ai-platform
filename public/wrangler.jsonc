{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jp-digital-ai-platform",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "workers_dev": true,

  "observability": {
    "enabled": true
  }
}
