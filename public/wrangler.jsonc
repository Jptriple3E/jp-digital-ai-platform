{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jp-digital-ai-platform",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jp-digital-ai-db",
      "database_id": "f01eadfb-a280-4ee9-97ec-1bf3c42ea933"
    }
  ],

  "workers_dev": true,

  "observability": {
    "enabled": true
  }
}
